/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wme-requests",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server-entry.ts",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"triggers": {
		// Daily at 03:00 UTC — purges requests older than 24h (see the `scheduled` handler
		// in src/server-entry.ts and Terms of Service §4).
		"crons": ["0 3 * * *"]
	},
	"vars": {
		// Origins allowed to call the API cross-origin (comma-separated, or * for all).
		// Restricted to Waze's own domains since the userscript is the only cross-origin
		// caller of the public POST /api/requests endpoint — everything else (the dashboard)
		// is same-origin and unaffected by this. Includes both waze.com and www.waze.com
		// since Waze's own generated links use the bare domain while the app may serve under www.
		"ALLOWED_ORIGINS": "https://waze.com,https://www.waze.com,https://beta.waze.com,https://requests.wazetools.com",
		// The "From" address for auth emails (password reset / invite) sent via Postmark —
		// must be a verified Sender Signature (or a domain you've verified) in your Postmark
		// account. The Postmark Server API Token itself is a secret, not a var — see DEPLOYMENT.md.
		"POSTMARK_FROM_EMAIL": "requests@mail.wazetools.com",
		// The dashboard's own deployed origin — required so invite/password-reset emails
		// link to an absolute URL instead of a bare path.
		"BETTER_AUTH_URL": "https://requests.wazetools.com",
		// Discord OAuth application's Client ID — not secret (it's embedded in the browser
		// authorize-URL anyway). The Client Secret is a Worker secret — see DEPLOYMENT.md.
		// Placeholder; replace with your own Discord application's Client ID.
		"DISCORD_CLIENT_ID": "1549709267475374100",
		// Web Push VAPID public key — safe to expose (it's sent to the browser as
		// applicationServerKey). The matching private key is WEB_PUSH_VAPID_PRIVATE_JWK,
		// a secret — see DEPLOYMENT.md. Placeholder; replace with your own generated pair.
		"WEB_PUSH_VAPID_PUBLIC_KEY": "BI7TZK5g2JTEXxFtmOy3KiCWs1rLvNAzsCNOWK_l3mb_jiyZrAKAyZOsYNuu0zIFJQxUXYoHIlTxz8R7v6ZrfR4",
		// Contact address required by the Web Push protocol (VAPID "sub" claim) so push
		// services can reach you about problems with your usage.
		"WEB_PUSH_CONTACT": "mailto:wazerequest@michaelrosstarr.com "
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wme-requests",
			// Replace with the ID printed by: wrangler d1 create wme-requests
			"database_id": "2af446ca-93ff-4681-ab5c-80edcd5098d0",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "SCREENSHOTS",
			// Replace with the name you passed to: wrangler r2 bucket create <name>
			"bucket_name": "wme-requests-screenshots"
		}
	]
}
